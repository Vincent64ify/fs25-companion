    <version>0.8.4</version>
    <title>
        <en>FS25 Companion</en>
    </title>
    <description>
        <en><![CDATA[Streams live game state (map, player, vehicles, sell points, shops, productions, farmlands, fields and crops, time and weather) to modSettings/FS25_Companion/stream.ndjson for the FS25 Companion browser map. It changes your game only when you tap a control on the dashboard (lights, engine, cruise, implement), and never your savegames.]]></en>
    </description>
    <iconFilename>icon.png</iconFilename>
    <multiplayer supported="true" />
